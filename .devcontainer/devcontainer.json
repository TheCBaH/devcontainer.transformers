// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "Transformers devcontainer",
    "build":  {
        "dockerfile": "Dockerfile",
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "./features/pip-packages": {
            "packages": "transformers torch rich accelerate"
        },
    },
    "hostRequirements": {
        "gpu": "optional"
    },
    "remoteUser": "vscode"
}
