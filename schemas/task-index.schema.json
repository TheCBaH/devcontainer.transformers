{
  "$id": "https://thecbah.github.io/devcontainer.transformers/schemas/task-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "release_tag",
    "request_sha256",
    "reference_publication",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string"
    },
    "release_tag": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_publication": {
      "$ref": "#/$defs/pin"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "artifact_id",
          "recipe_id",
          "recipe_sha256",
          "kind",
          "expected_cases",
          "assets"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "recipe_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "recipe_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "acceptance",
              "diagnostic"
            ]
          },
          "expected_cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "archive",
              "manifest"
            ],
            "properties": {
              "archive": {
                "$ref": "#/$defs/pin"
              },
              "manifest": {
                "$ref": "#/$defs/pin"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 805306368
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      }
    }
  }
}
