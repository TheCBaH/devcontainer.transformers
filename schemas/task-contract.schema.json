{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tensor_format",
    "kind",
    "fixture_id",
    "artifact_id",
    "recipe_id",
    "recipe",
    "recipe_sha256",
    "request_sha256",
    "references",
    "reference_publication",
    "generator",
    "model_loading",
    "expected_cases",
    "tolerances",
    "consumer_status",
    "cases",
    "producer_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tensor_format": {
      "const": "torch-flat-tensor-map-v1"
    },
    "kind": {
      "enum": [
        "acceptance",
        "diagnostic"
      ]
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "recipe": {
      "type": "object"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "model_id",
          "population",
          "component",
          "graph_sha256",
          "producer_commit",
          "weight_source",
          "contract",
          "graph",
          "map",
          "config",
          "assets",
          "release_environment",
          "tolerances"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "const": "reference"
          },
          "producer_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "graph_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "contract": {
            "$ref": "#/$defs/pin"
          },
          "graph": {
            "$ref": "#/$defs/pin"
          },
          "map": {
            "$ref": "#/$defs/pin"
          },
          "config": {
            "$ref": "#/$defs/pin"
          },
          "tolerances": {
            "$ref": "#/$defs/tolerances"
          },
          "weight_source": {
            "type": "object",
            "required": [
              "kind",
              "repo",
              "revision",
              "config_sha256",
              "files"
            ],
            "properties": {
              "kind": {
                "const": "checkpoint"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/pin"
                }
              }
            }
          },
          "assets": {
            "type": "object",
            "required": [
              "archive",
              "manifest"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/pin"
            }
          }
        }
      }
    },
    "reference_publication": {
      "$ref": "#/$defs/pin"
    },
    "generator": {
      "type": "object",
      "required": [
        "commit",
        "lock_sha256",
        "python",
        "architecture",
        "packages",
        "cpu",
        "generator_sources",
        "routes",
        "consumer_execution"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "consumer_execution": {
          "const": "not_measured"
        }
      }
    },
    "model_loading": {
      "type": "object"
    },
    "expected_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tolerances": {
      "$ref": "#/$defs/tolerances"
    },
    "consumer_status": {
      "const": "not_measured"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "raw",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "raw": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/pin"
                },
                {
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tensors"
              ],
              "properties": {
                "tensors": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/tensor"
                  }
                }
              }
            }
          }
        }
      }
    },
    "producer_status": {
      "enum": [
        "verified",
        "diagnostic"
      ]
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 805306368
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        }
      }
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "enum": [
            "float32",
            "int64",
            "uint8",
            "bool"
          ]
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atol",
        "rtol"
      ],
      "properties": {
        "atol": {
          "type": "number",
          "minimum": 0
        },
        "rtol": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
