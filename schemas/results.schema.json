{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecbah.github.io/devcontainer.transformers/schemas/results.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "population",
    "attempted",
    "verified",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "population": {
      "enum": [
        "tiny",
        "reference"
      ]
    },
    "attempted": {
      "type": "integer",
      "minimum": 0
    },
    "verified": {
      "type": "integer",
      "minimum": 0
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "status",
          "stages",
          "producer"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "crashed"
            ]
          },
          "stages": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "failed",
                    "not_run"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
